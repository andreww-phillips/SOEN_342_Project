  <diagram name="Page-1" id="6DzlXPat7TIHcjSUsvEK">
    <mxGraphModel dx="2965" dy="1652" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {\&quot;layout\&quot;: \&quot;elk\&quot;, \&quot;class\&quot;: {\&quot;nodeSpacing\&quot;: 110, \&quot;rankSpacing\&quot;: 140}}}%%\nclassDiagram\n    direction TB\n\n    %% PATIENTS AND PEOPLE\n\n    class Patient {\n        patientId: String\n        firstName: String\n        lastName: String\n        dateOfBirth: Date\n        phone: String\n        insuranceNumber: String\n        coverageType: String\n    }\n\n    class User {\n        userId: String\n    }\n\n    class HealthcareProfessional {\n        professionalId: String\n        name: String\n        profession: String\n    }\n\n    class ExternalPhysician {\n        name: String\n    }\n\n    class AdministrativeStaff {\n        staffId: String\n        name: String\n    }\n\n    %% USER GENERALIZATION\n\n    User &lt;|-- HealthcareProfessional\n    User &lt;|-- AdministrativeStaff\n\n    %% CLINIC AND SCHEDULING\n\n    class ClinicLocation {\n        name: String\n    }\n\n    class Specialty {\n        specialtyId: String\n        name: String\n    }\n\n    class Schedule\n\n    class TimeSlot {\n        start: DateTime\n        end: DateTime\n    }\n\n    class MedicalService {\n        name: String\n        fee: Decimal\n        requiresReferral: Boolean\n    }\n\n    class Appointment {\n        appointmentId: String\n        status: String\n        requestedStart: DateTime\n        requestedEnd: DateTime\n        bookedAt: DateTime\n        arrivedAt: DateTime\n    }\n\n    %% REFERRALS\n\n    class Referral {\n        clinicalReason: String\n        priority: String\n        status: String\n    }\n\n    %% CONSULTATIONS\n\n    class Consultation {\n        consultationId: String\n        status: String\n        startedAt: DateTime\n        endedAt: DateTime\n    }\n\n    class ClinicalRecord {\n        observations: String\n        diagnoses: String\n        treatmentRecommendations: String\n        followUpRequirements: String\n    }\n\n    class Prescription {\n        issuedAt: DateTime\n    }\n\n    class PrescriptionItem {\n        dosage: String\n        frequency: String\n        duration: String\n        quantity: Integer\n    }\n\n    class Medication {\n        name: String\n    }\n\n    class FollowUpRequest {\n        details: String\n        requestedAt: DateTime\n    }\n\n    %% BILLING\n\n    class Invoice {\n        totalAmount: Decimal\n    }\n\n    class Payment {\n        amount: Decimal\n    }\n\n    %% APPOINTMENT ASSOCIATIONS\n\n    Patient \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : has\n    HealthcareProfessional \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : scheduledWith\n    MedicalService \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : requestedFor\n    TimeSlot \&quot;0..1\&quot; -- \&quot;0..*\&quot; Appointment : allocatedTo\n    User \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : requestedBy\n\n    %% SCHEDULING ASSOCIATIONS\n\n    HealthcareProfessional \&quot;1\&quot; -- \&quot;0..*\&quot; Schedule : has\n    Schedule \&quot;1\&quot; -- \&quot;0..*\&quot; TimeSlot : contains\n    HealthcareProfessional \&quot;0..*\&quot; -- \&quot;0..*\&quot; Specialty : has\n    HealthcareProfessional \&quot;0..*\&quot; -- \&quot;1..*\&quot; ClinicLocation : practisesAt\n\n    %% REFERRAL ASSOCIATIONS\n\n    Patient \&quot;1\&quot; -- \&quot;0..*\&quot; Referral : has\n    Referral \&quot;0..1\&quot; -- \&quot;0..*\&quot; Appointment : supports\n\n    HealthcareProfessional \&quot;0..1\&quot; -- \&quot;0..*\&quot; Referral : internalReferrer\n    ExternalPhysician \&quot;0..1\&quot; -- \&quot;0..*\&quot; Referral : externalReferrer\n    HealthcareProfessional \&quot;0..1\&quot; -- \&quot;0..*\&quot; Referral : requestedProfessional\n    Specialty \&quot;0..1\&quot; -- \&quot;0..*\&quot; Referral : requestedSpecialty\n    User \&quot;1\&quot; -- \&quot;0..*\&quot; Referral : recordedBy\n\n    %% CONSULTATION ASSOCIATIONS\n\n    Appointment \&quot;1\&quot; -- \&quot;0..*\&quot; Consultation : has\n    HealthcareProfessional \&quot;1\&quot; -- \&quot;0..*\&quot; Consultation : conducts\n    Consultation \&quot;1\&quot; -- \&quot;1\&quot; ClinicalRecord : documentedIn\n    Patient \&quot;1\&quot; -- \&quot;0..*\&quot; ClinicalRecord : has\n\n    Consultation \&quot;1\&quot; -- \&quot;0..*\&quot; Prescription : produces\n    Prescription \&quot;1\&quot; -- \&quot;1..*\&quot; PrescriptionItem : contains\n    Medication \&quot;1\&quot; -- \&quot;0..*\&quot; PrescriptionItem : identifies\n\n    Consultation \&quot;1\&quot; -- \&quot;0..*\&quot; FollowUpRequest : requests\n\n    %% BILLING ASSOCIATIONS\n\n    Appointment \&quot;1\&quot; -- \&quot;0..*\&quot; Invoice : billedFor\n    Invoice \&quot;1\&quot; -- \&quot;0..*\&quot; Payment : receives\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="LqvdVMJ8r_wlq1wRXsIx-171">
